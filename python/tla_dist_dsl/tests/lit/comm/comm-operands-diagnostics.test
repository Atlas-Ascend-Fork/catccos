// RUN: sed -n '/^\/\/ BEGIN_REMOTE-COPY-ELEMENT-TYPE$/,/^\/\/ END_REMOTE-COPY-ELEMENT-TYPE$/p' %s | sed '1d;$d;s|^// ||' > %t.REMOTE-COPY-ELEMENT-TYPE.mlir && not %tla_dist_compile %t.REMOTE-COPY-ELEMENT-TYPE.mlir -o - 2>&1 | %filecheck %s --check-prefix=REMOTE-COPY-ELEMENT-TYPE

// REMOTE-COPY-ROUTE: error: 'tla_dist.remote_copy' op this route does not accept ub_tensor or event_id
// REMOTE-COPY-LAYOUT: error: 'tla_dist.remote_copy' op requires row-major src and dst
// REMOTE-COPY-DTYPE: error: 'tla_dist.remote_copy' op requires identical src/dst element types
// REMOTE-COPY-SCRATCH-SPACE: error: 'tla_dist.remote_copy' op requires its scratch tensor in UB
// REMOTE-COPY-SCRATCH-DTYPE: error: 'tla_dist.remote_copy' op requires identical src and UB scratch element types
// REMOTE-COPY-ELEMENT-TYPE: error: 'tla_dist.remote_copy' op currently supports only f32 tensors

